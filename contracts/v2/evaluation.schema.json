{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvaluationResultV2",
  "type": "object",
  "properties": {
    "schema_version": {
      "title": "Schema Version",
      "enum": [
        "evaluation.v2-draft"
      ],
      "type": "string"
    },
    "evaluation_only": {
      "title": "Evaluation Only",
      "enum": [
        true
      ],
      "type": "boolean"
    },
    "context": {
      "$ref": "#/definitions/ExecutionReference"
    },
    "proposed_actions": {
      "title": "Proposed Actions",
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/definitions/ProposedAction"
      }
    },
    "actions": {
      "title": "Actions",
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/definitions/FinalAction"
      }
    },
    "safety": {
      "$ref": "#/definitions/SafetyAudit"
    },
    "input_evidence": {
      "$ref": "#/definitions/InputEvidence"
    },
    "providers": {
      "title": "Providers",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
      }
    },
    "request_id": {
      "anyOf": [
        {
          "title": "Request Id",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
