        "manifest_sha256": {
          "title": "Manifest Sha256",
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "agent_index": {
          "title": "Agent Index",
          "minimum": 0,
          "type": "integer"
        },
        "message_profile": {
          "title": "Message Profile",
          "enum": [
            "percepta.mongo-message.v0"
