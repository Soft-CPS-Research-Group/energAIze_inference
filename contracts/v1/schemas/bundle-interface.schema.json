{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BundleInterface",
  "type": "object",
  "properties": {
    "schema_version": {
      "title": "Schema Version",
      "enum": [
        "bundle-interface.v1-draft"
      ],
      "type": "string"
    },
    "bundle_id": {
      "title": "Bundle Id",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "type": "string"
    },
    "revision": {
      "title": "Revision",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "type": "string"
    },
    "manifest_sha256": {
      "anyOf": [
        {
          "title": "Manifest Sha256",
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "target_site_id": {
      "title": "Target Site Id",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "type": "string"
    },
    "agent_index": {
      "title": "Agent Index",
      "minimum": 0,
      "type": "integer"
    },
    "runtime": {
      "title": "Runtime",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "type": "string"
    },
    "topology_support": {
      "title": "Topology Support",
      "enum": [
        "fixed",
        "dynamic",
        "unspecified"
      ],
      "type": "string"
    },
    "inputs": {
      "title": "Inputs",
      "type": "array",
      "items": {
        "$ref": "#/definitions/SignalRequirement"
      }
    },
    "outputs": {
      "title": "Outputs",
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/definitions/SignalRequirement"
      }
    }
  },
  "required": [
    "schema_version",
    "bundle_id",
    "revision",
    "target_site_id",
    "agent_index",
    "runtime",
    "topology_support",
    "inputs",
    "outputs"
  ],
  "additionalProperties": false,
  "definitions": {
    "SignalMeaning": {
      "title": "SignalMeaning",
      "type": "object",
      "properties": {
        "quantity": {
          "title": "Quantity",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "value_type": {
          "title": "Value Type",
          "enum": [
            "number",
            "string",
            "boolean",
            "number_vector"
          ],
          "type": "string"
        },
        "value_semantics": {
          "title": "Value Semantics",
          "enum": [
            "instantaneous",
            "state",
            "interval",
            "cumulative",
            "forecast",
            "command",
            "unknown"
          ],
          "type": "string"
        },
        "positive_direction": {
          "title": "Positive Direction",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "interval_seconds": {
          "anyOf": [
            {
              "title": "Interval Seconds",
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "quantity",
        "unit",
        "value_type",
        "value_semantics",
        "positive_direction"
      ],
      "additionalProperties": false
    },
    "SignalRequirement": {
      "title": "SignalRequirement",
      "type": "object",
      "properties": {
        "name": {
          "title": "Name",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "meaning": {
          "$ref": "#/definitions/SignalMeaning"
        }
      },
      "required": [
        "name",
        "meaning"
      ],
      "additionalProperties": false
    }
  }
}
