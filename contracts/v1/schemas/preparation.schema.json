{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PreparationRequest",
  "type": "object",
  "properties": {
    "schema_version": {
      "title": "Schema Version",
      "enum": [
        "preparation.v1-draft"
      ],
      "type": "string"
    },
    "configuration_revision": {
      "title": "Configuration Revision",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "configuration_revision"
  ],
  "additionalProperties": false
}
