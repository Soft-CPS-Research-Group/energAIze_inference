{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ActivationRequest",
  "type": "object",
  "properties": {
    "schema_version": {
      "title": "Schema Version",
      "enum": [
        "activation.v1-draft"
      ],
      "type": "string"
    },
    "candidate_id": {
      "title": "Candidate Id",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "type": "string"
    },
    "expected_activation_id": {
      "anyOf": [
        {
          "title": "Expected Activation Id",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "candidate_id",
    "expected_activation_id"
  ],
  "additionalProperties": false
}
